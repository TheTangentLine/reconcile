server {
  # Filled in at container start by the nginx image's envsubst step:
  #   API_UPSTREAM  where /api is proxied to
  #   DNS_RESOLVER  DNS server used to re-resolve that host
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # API requests go to the backend.
  location /api/ {
    # Re-resolved every 10s so a recreated backend container / pod is found.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend ${API_UPSTREAM};
    proxy_pass $backend;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed build assets never change, so cache them for a long time.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Client-side routes (/method/cfop, ...) fall back to index.html.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
